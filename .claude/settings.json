{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(cd web && pytest*)",
      "Bash(python -m pytest*)",
      "Bash(.venv/bin/python*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin main)",
      "Bash(git show*)",
      "Bash(grep*)",
      "Bash(find . *)",
      "Bash(ls*)",
      "Bash(cat CHANGELOG.md)",
      "Bash(npm install*)",
      "Bash(npx*)",
      "Bash(pip install*)",
      "Bash(lsof*)",
      "Bash(curl -s http://localhost*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(sudo*)"
    ]
  }
}
