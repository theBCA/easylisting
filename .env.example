# Etsy Developer App credentials (from developers.etsy.com)
ETSY_API_KEY=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here

# After deploying, set this to your live URL
REDIRECT_URI=https://your-app.railway.app/auth/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=change-this-to-a-long-random-string

# Set to "production" on Railway
ENV=production

# Railway: mount a Volume at /data, then set this
# DB_PATH=/data/easylisting.sqlite

# Stripe (from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_STARTER_PRICE_ID=   # €4.99/mo product price ID
STRIPE_PRO_PRICE_ID=       # €9.99/mo product price ID
STRIPE_WEBHOOK_SECRET=     # from Stripe webhook endpoint settings

# AI Keys (at least one required)
GEMINI_API_KEY=        # free — aistudio.google.com
NVIDIA_API_KEY=        # free — build.nvidia.com
OPENAI_API_KEY=        # paid — platform.openai.com
