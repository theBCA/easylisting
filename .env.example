# Etsy Developer App credentials (from developers.etsy.com)
ETSY_API_KEY=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here

# After deploying, set this to your live URL
REDIRECT_URI=https://your-app.railway.app/auth/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=change-this-to-a-long-random-string

# Set to "production" on Railway
ENV=production

# Railway: mount a Volume at /data, then set this
# DB_PATH=/data/easylisting.sqlite

